&НаСервере
Функция ПолучитьСвойствоНоменклатуры(Объект)
	Возврат Объект.ВидНоменклатуры.ИспользоватьХарактеристики;	
КонецФункции



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗначениеХарактеристик.Свойство КАК Свойство,
		               |	ЗначениеХарактеристик.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.ЗначениеХарактеристик КАК ЗначениеХарактеристик
		               |ГДЕ
		               |	ЗначениеХарактеристик.Характеристика = &Характеристика";
		Запрос.УстановитьПараметр("Характеристика", Объект.Ссылка);
		 РезультатЗапроса = Запрос.Выполнить();
        	Если НЕ РезультатЗапроса.Пустой() Тогда
            		Выборка = РезультатЗапроса.Выбрать();
            		Пока Выборка.Следующий() Цикл
                	// Проверяем, какое свойство мы сейчас читаем, и кладем его значение
               	 // в соответствующий реквизит формы.
                		Если Выборка.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.Дозировка Тогда
                    			Дозировка = Выборка.Значение;
                		ИначеЕсли Выборка.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.ФормаВыпуска Тогда
                    			ФормаВыпуска = Выборка.Значение;  
				ИначеЕсли Выборка.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.ЕдиницаИзмерения Тогда
                			ЕдиницаИзмерения = Выборка.Значение;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
       КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)  
	
   ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(Объект.Владелец);
   Если НЕ ИспользоватьХарактеристики Тогда
	   Возврат;
	КонецЕсли;
	
	// Процедура записи. Теперь она создает ДВЕ записи в регистре.
    НаборЗаписей = РегистрыСведений.ЗначениеХарактеристик.СоздатьНаборЗаписей();
    // Этот отбор важен! Он удаляет СТАРЫЕ записи для этой характеристики перед записью новых.
    НаборЗаписей.Отбор.Характеристика.Установить(Объект.Ссылка);
    
    // --- Запись 1: Дозировка ---
    НоваяЗаписьДозировка = НаборЗаписей.Добавить();
    НоваяЗаписьДозировка.Характеристика = Объект.Ссылка;
    // Указываем, что это за свойство (берем предопределенный элемент из ПВХ)
    НоваяЗаписьДозировка.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.Дозировка;
    // Указываем его значение (из реквизита формы)
    НоваяЗаписьДозировка.Значение = Дозировка;

    // --- Запись 2: Форма выпуска ---
    НоваяЗаписьФорма = НаборЗаписей.Добавить();
    НоваяЗаписьФорма.Характеристика = Объект.Ссылка;
    // Указываем, что это за свойство
    НоваяЗаписьФорма.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.ФормаВыпуска;
    // Указываем его значение
    НоваяЗаписьФорма.Значение = ФормаВыпуска;  
	
    НоваяЗаписьЕдИзм = НаборЗаписей.Добавить();
    НоваяЗаписьЕдИзм.Характеристика = Объект.Ссылка;
    НоваяЗаписьЕдИзм.Свойство = ПланыВидовХарактеристик.СвойстваНоменклатуры.ЕдиницаИзмерения;
    НоваяЗаписьЕдИзм.Значение = ЕдиницаИзмерения;
    // Записываем обе записи в базу данных одним махом.
    НаборЗаписей.Записать();
КонецПроцедуры


&НаКлиенте
Процедура ФормаВыпускаПриИзменении(Элемент)
	СформироватьНаименование();
КонецПроцедуры


&НаКлиенте
Процедура ДозировкаПриИзменении(Элемент)
	СформироватьНаименование();
КонецПроцедуры  

&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	СформироватьНаименование();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименование()
    ТекстДозировки = "";
    // Проверяем, что дозировка и единица измерения заполнены
    Если Дозировка > 0 И ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
        // Обращаемся к реквизиту ЕдиницаИзмерения и получаем его КраткоеНаименование
        ТекстДозировки = Формат(Дозировка, "ЧГ=0") + " " + ЕдиницаИзмерения;
    КонецЕсли;
    
    НаименованиеФормы = "" + ФормаВыпуска;

    // Собираем все вместе, убирая лишние запятые и пробелы
    Если НЕ ПустаяСтрока(НаименованиеФормы) И НЕ ПустаяСтрока(ТекстДозировки) Тогда
        Объект.Наименование = НаименованиеФормы + ", " + ТекстДозировки;
    Иначе
        Объект.Наименование = НаименованиеФормы + ТекстДозировки;
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(Объект.Владелец);
    	Элементы.ФормаВыпуска.Видимость = ИспользоватьХарактеристики;
	Элементы.Дозировка.Видимость = ИспользоватьХарактеристики;
	Элементы.ЕдиницаИзмерения.Видимость = ИспользоватьХарактеристики;
	Элементы.Наименование.Доступность = НЕ ИспользоватьХарактеристики;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	  Запрос = Новый Запрос();
	  Запрос.Текст =  "ВЫБРАТЬ
	                  |	ХарактеристикиНоменклатуры.Наименование КАК Наименование,
	                  |	ХарактеристикиНоменклатуры.Владелец КАК Владелец
	                  |ИЗ
	                  |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                  |ГДЕ
	                  |	ХарактеристикиНоменклатуры.Наименование = &НовоеНаименование
	                  |	И ХарактеристикиНоменклатуры.Владелец = &Владелец";
	  Запрос.УстановитьПараметр("НовоеНаименование", Объект.Наименование);
	  Запрос.УстановитьПараметр("Владелец", Объект.Владелец);
	  РезультатЗапроса = Запрос.Выполнить();
	  Если НЕ РезультатЗапроса.Пустой() Тогда
		  Сообщить("Такие характеристики уже существуют!");
		  Отказ = Истина;
	  КонецЕсли;
	  ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(Объект.Владелец);
	  Если ИспользоватьХарактеристики И (НЕ ЗначениеЗаполнено(ФормаВыпуска) ИЛИ НЕ ЗначениеЗаполнено(Дозировка) ИЛИ НЕ ЗначениеЗаполнено(ЕдиницаИзмерения)) Тогда
		  Сообщить("Для лекарственных средств обязательно надо указать форму выпуска и дозировку с единицей измерения!");
		  Отказ = Истина;
	КонецЕсли;
КонецПроцедуры



