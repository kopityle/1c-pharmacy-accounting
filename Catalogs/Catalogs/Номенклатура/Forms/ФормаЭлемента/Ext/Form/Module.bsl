    

&НаСервере
Функция ПолучитьСвойствоНоменклатуры(ВидНоменклатуры)
	Возврат ВидНоменклатуры.ИспользоватьХарактеристики;	
КонецФункции


&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент) 
	 
	ВидНоменклатуры = Объект.ВидНоменклатуры;
	ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(ВидНоменклатуры);
	Элементы.ГруппаХарактеристик.Видимость = ИспользоватьХарактеристики;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	ВидНоменклатуры = Объект.ВидНоменклатуры;
	ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(ВидНоменклатуры);

	Если НЕ ИспользоватьХарактеристики Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Объект.МНН) Тогда
		Сообщить("Для лекарства нужно указать действующее вещество (МНН)!");
		Отказ = Истина; 
	 	Элементы.ГруппаХарактеристик.Видимость = ИспользоватьХарактеристики; 
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Объект.СрокГодностиМесяцев) Тогда
		 Сообщить( "Для лекарственного средства необходимо указать его срок годности");
       	Отказ = Истина; 
	 	Элементы.ГруппаХарактеристик.Видимость = ИспользоватьХарактеристики;
	КонецЕсли; 
КонецПроцедуры         

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидНоменклатуры = Объект.ВидНоменклатуры;
	ИспользоватьХарактеристики = ПолучитьСвойствоНоменклатуры(ВидНоменклатуры);
	Элементы.ГруппаХарактеристик.Видимость = ИспользоватьХарактеристики;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
        ТекстСообщения = "Карточка товара сохранена. " 
                        + "Теперь, пожалуйста, перейдите на вкладку 'Характеристики' "
                        + "и добавьте хотя бы одну характеристику.";                 
        Сообщить(ТекстСообщения);
КонецПроцедуры

Если Объект.ВидНоменклатуры.Пустая() Тогда
	Элементы.ГруппаХарактеристик.Видимость = Ложь; 
КонецЕсли;
