Процедура ОбработкаПроведения(Отказ, Режим) 
	
	 Движения.ТоварыНаСкладах.Записать();
    	Движения.Продажи.Записать(); 

	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
        Если ТекСтрокаТовары.Номенклатура.ТребуетРецепт Тогда
    
    // Проверка 1: Рецепт в принципе указан?
    Если НЕ ЗначениеЗаполнено(ТекСтрокаТовары.Рецепт) Тогда
        ТекстСообщения = "Для товара '" + ТекСтрокаТовары.Номенклатура + "' в строке №" 
                        + ТекСтрокаТовары.НомерСтроки + " не указан рецепт!";
	Сообщить(ТекстСообщения);
	Отказ = Истина;
        Возврат; // Дальше не проверяем
    КонецЕсли;
    
    // Проверка 2: Соответствует ли товар в строке товару в рецепте?
	РецептОбъект = ТекСтрокаТовары.Рецепт.ПолучитьОбъект();  
	
    Если РецептОбъект.Номенклатура <> ТекСтрокаТовары.Номенклатура 
         ИЛИ РецептОбъект.Характеристика <> ТекСтрокаТовары.Характеристика Тогда
         
        ТекстСообщения = "Ошибка в строке №" + ТекСтрокаТовары.НомерСтроки 
                        + "! Товар не соответствует указанному рецепту. Рецепт выписан на '" 
                        + РецептОбъект.Номенклатура + " (" + РецептОбъект.Характеристика + ")'.";
        Сообщить(ТекстСообщения);
	Отказ = Истина;
        Возврат;
    КонецЕсли;
    
КонецЕсли; 
	КонецЦикла;
	

			
	ТаблицаСписания = Новый ТаблицаЗначений;
	ТаблицаСписания.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписания.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
       ТаблицаСписания.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));  
	ТаблицаСписания.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады")); 
       ТаблицаСписания.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
       ТаблицаСписания.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	   
	   Для Каждого ТекСтрокаТовары из Товары Цикл
		  КоличествоКСписанию = ТекСтрокаТовары.Количество; 
		  
		  Запрос = Новый Запрос;
		  Запрос.Текст =  "ВЫБРАТЬ
		                  |	ТоварыНаСкладахОстатки.Серия КАК Серия,
		                  |	ТоварыНаСкладахОстатки.Серия.СрокГодности КАК СерияСрокГодности,
		                  |	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
		                  |	ТоварыНаСкладахОстатки.СуммаОстаток КАК СуммаОстаток
		                  |ИЗ
		                  |	РегистрНакопления.ТоварыНаСкладах.Остатки(
		                  |			&МоментВремени,
		                  |			Склад = &Склад
		                  |				И Номенклатура = &Номенклатура
		                  |				И Характеристика = &Характеристика) КАК ТоварыНаСкладахОстатки
		                  |ГДЕ
		                  |	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
		                  |
		                  |УПОРЯДОЧИТЬ ПО
		                  |	СерияСрокГодности";
		  	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
		  	Запрос.УстановитьПараметр("Склад", ТекСтрокаТовары.Склад);
        	  	Запрос.УстановитьПараметр("Номенклатура", ТекСтрокаТовары.Номенклатура);
        	 	 Запрос.УстановитьПараметр("Характеристика", ТекСтрокаТовары.Характеристика); 
			 Выборка = Запрос.Выполнить().Выбрать();  
			 
			 Пока Выборка.Следующий() И КоличествоКСписанию > 0 Цикл
				 СписываемоеКоличество = Мин(КоличествоКСписанию, Выборка.КоличествоОстаток);
				 СебестоимостьСписания = 0;
            			Если Выборка.КоличествоОстаток <> 0 Тогда
                			СебестоимостьСписания = (Выборка.СуммаОстаток / Выборка.КоличествоОстаток) * СписываемоеКоличество;
            			КонецЕсли;
				 НоваяСтрока = ТаблицаСписания.Добавить();
            			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
            			НоваяСтрока.Характеристика = ТекСтрокаТовары.Характеристика;
            			НоваяСтрока.Серия = Выборка.Серия;
				НоваяСтрока.Склад = ТекСтрокаТовары.Склад;		
            			НоваяСтрока.Количество = СписываемоеКоличество;
            			НоваяСтрока.Себестоимость = СебестоимостьСписания; 
						
				КоличествоКСписанию = КоличествоКСписанию - СписываемоеКоличество;
			КонецЦикла;
			Если КоличествоКСписанию > 0 Тогда
				ТекстСообщения = "Недостаточно товара '" + ТекСтрокаТовары.Номенклатура + "' (" + ТекСтрокаТовары.Характеристика + ") на складе! Не хватает " + КоличествоКСписанию + " шт.";
				Сообщить(ТекстСообщения);
				Отказ = Истина;
			КонецЕсли; 
		КонецЦикла;
		
		Если Отказ Тогда
        		Возврат;
		КонецЕсли; 
			
		// 2.1 Движения по складу (Расход)
    Движения.ТоварыНаСкладах.Записывать = Истина;
    Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
        Движение = Движения.ТоварыНаСкладах.ДобавитьРасход();
        Движение.Период = Дата;
        Движение.Склад = СтрокаСписания.Склад;
        Движение.Номенклатура = СтрокаСписания.Номенклатура;
        Движение.Характеристика = СтрокаСписания.Характеристика;
        Движение.Серия = СтрокаСписания.Серия;
        Движение.Количество = СтрокаСписания.Количество;
        Движение.Сумма = СтрокаСписания.Себестоимость; 
	КонецЦикла;
	
	Движения.Продажи.Записывать = Истина;
	
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
        Движение = Движения.Продажи.Добавить();
        Движение.Период = Дата;
        Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
        Движение.Характеристика = ТекСтрокаТовары.Характеристика;
        Движение.Склад = СтрокаСписания.Склад;
        Движение.Количество = ТекСтрокаТовары.Количество;
        Движение.СуммаПродажи = ТекСтрокаТовары.Сумма;
        
        // Рассчитываем итоговую себестоимость для этой товарной позиции
        ПараметрыОтбора = Новый Структура("Номенклатура, Характеристика", 
                                    ТекСтрокаТовары.Номенклатура, 
                                    ТекСтрокаТовары.Характеристика);
    
    // 2. Находим ВСЕ строки списания, относящиеся к текущему товару
    	НайденныеСтроки = ТаблицаСписания.НайтиСтроки(ПараметрыОтбора);
    
    	// 3. Считаем итоговую себестоимость, пробегаясь в цикле по найденным строкам
   	 ИтоговаяСебестоимость = 0;
    		Для Каждого СтрокаСписания Из НайденныеСтроки Цикл
        ИтоговаяСебестоимость = ИтоговаяСебестоимость + СтрокаСписания.Себестоимость;
    КонецЦикла;
        Движение.Себестоимость = ИтоговаяСебестоимость;
    КонецЦикла;
КонецПроцедуры
