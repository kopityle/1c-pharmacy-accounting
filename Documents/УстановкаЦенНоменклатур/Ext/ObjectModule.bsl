Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    // Делаем движения по регистру ЦеныНоменклатуры
    Движения.ЦеныНоменклатуры.Записывать = Истина; // Разрешаем запись в регистр
    Движения.ЦеныНоменклатуры.Записать(); // Очищаем старые движения этого документа

    // Проходим по каждой строке нашей табличной части
    Для Каждого ТекСтрокаТовары Из Товары Цикл
        // Создаем новую запись в "книге цен"
        Движение = Движения.ЦеныНоменклатуры.Добавить();
        // Указываем дату записи (дату документа)
        Движение.Период = Дата;
        // Заполняем измерения и ресурсы из текущей строки
        Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
        Движение.Характеристика = ТекСтрокаТовары.Характеристика;
        Движение.ТипЦены = ТипЦен; // Из шапки документа
        Движение.Цена = ТекСтрокаТовары.Цена;
    КонецЦикла;
КонецПроцедуры

