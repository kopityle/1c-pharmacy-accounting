Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Движения.ТоварыНаСкладах.Записывать = Истина;
    Движения.ТоварыНаСкладах.Записать(); // Очищаем старые движения
    
    Для Каждого ТекСтрокаТовары Из Товары Цикл
        
        // Если отклонение есть, нужно сделать движение
        Если ТекСтрокаТовары.Отклонение <> 0 Тогда
            
            // Если отклонение положительное - это излишек, делаем ПРИХОД
            Если ТекСтрокаТовары.Отклонение > 0 Тогда
                Движение = Движения.ТоварыНаСкладах.ДобавитьПриход();
                Движение.Количество = ТекСтрокаТовары.Отклонение;
                // Сумму излишка пока не можем определить, ставим 0. 
                // В реальных системах это предмет отдельного учета.
                Движение.Сумма = 0; 
                
            // Если отклонение отрицательное - это недостача, делаем РАСХОД
            Иначе // (ТекСтрокаТовары.Отклонение < 0)
                // --- РАСЧЕТ СЕБЕСТОИМОСТИ ДЛЯ СПИСАНИЯ ---
            Запрос = Новый Запрос;
            Запрос.Текст = 
                "ВЫБРАТЬ
                |   ТоварыНаСкладахОстатки.СуммаОстаток,
                |   ТоварыНаСкладахОстатки.КоличествоОстаток
                |ИЗ
                |   РегистрНакопления.ТоварыНаСкладах.Остатки(
                |       &МоментВремени,
                |       Склад = &Склад
                |           И Номенклатура = &Номенклатура
                |           И Характеристика = &Характеристика
                |           И Серия = &Серия) КАК ТоварыНаСкладахОстатки";
            
            Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
            Запрос.УстановитьПараметр("Склад", Склад);
            Запрос.УстановитьПараметр("Номенклатура", ТекСтрокаТовары.Номенклатура);
            Запрос.УстановитьПараметр("Характеристика", ТекСтрокаТовары.Характеристика);
            Запрос.УстановитьПараметр("Серия", ТекСтрокаТовары.Серия);
            
            Выборка = Запрос.Выполнить().Выбрать();
            
            СуммаСписания = 0;
            Если Выборка.Следующий() Тогда
                // Проверка на деление на ноль
                Если Выборка.КоличествоОстаток <> 0 Тогда
                    // Вот она, наша формула!
                    СебестоимостьОднойШтуки = Выборка.СуммаОстаток / Выборка.КоличествоОстаток;
                    // Сумма списания = Себестоимость * Количество. Количество берем с минусом из отклонения.
                    СуммаСписания = СебестоимостьОднойШтуки * (-ТекСтрокаТовары.Отклонение);
                КонецЕсли;
            КонецЕсли;            
            Движение = Движения.ТоварыНаСкладах.ДобавитьРасход();
            // Важно: количество в движении всегда положительное!
            Движение.Количество = -ТекСтрокаТовары.Отклонение;
            Движение.Сумма = СуммаСписания;
            КонецЕсли;
            
            // Заполняем общие для обоих движений поля
            Движение.Период = Дата;
            Движение.Склад = Склад;
            Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
            Движение.Характеристика = ТекСтрокаТовары.Характеристика;
            Движение.Серия = ТекСтрокаТовары.Серия;
        
        КонецЕсли;
        
    КонецЦикла;

КонецПроцедуры