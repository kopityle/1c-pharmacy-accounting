Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Движения.ТоварыНаСкладах.Записывать = Истина;

    Для Каждого ТекСтрокаТовары Из Товары Цикл
        
        // --- Блок поиска/создания Серии (он у вас правильный) ---
        СсылкаНаСерию = Справочники.СерииНоменклатуры.НайтиПоНаименованию(
            ТекСтрокаТовары.НомерСерии, 
            Истина,
            ТекСтрокаТовары.Номенклатура);
            
        Если НЕ ЗначениеЗаполнено(СсылкаНаСерию) Тогда
            НоваяСерия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
            НоваяСерия.Владелец = ТекСтрокаТовары.Номенклатура;
            НоваяСерия.Наименование = ТекСтрокаТовары.НомерСерии;
            НоваяСерия.СрокГодности = ТекСтрокаТовары.СрокГодности;
            НоваяСерия.Записать();
            СсылкаНаСерию = НоваяСерия.Ссылка;
        КонецЕсли;
        
        // --- Блок создания и ЗАПОЛНЕНИЯ движения ---
        Движение = Движения.ТоварыНаСкладах.ДобавитьПриход();
        
          // Заполняем измерения (аналитику) движения
        Движение.Период = Дата;
        Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
        Движение.Характеристика = ТекСтрокаТовары.Характеристика;
        Движение.Склад = Склад; 
	Движение.Серия = СсылкаНаСерию;
        
        // Заполняем ресурсы (количественные показатели) движения
        Движение.Количество = ТекСтрокаТовары.Количество;
        Движение.Сумма = ТекСтрокаТовары.Сумма;
        
    КонецЦикла;

КонецПроцедуры