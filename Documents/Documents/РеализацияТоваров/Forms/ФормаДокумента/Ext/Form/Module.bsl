&НаСервере
Функция ПолучитьЦенуНаСервере(Номенклатура, Характеристика) 
	ТипЦены = Неопределено;
	Если Объект.ТипРеализации = Перечисления.ТипыРеализации.Розница Тогда
		ТипЦены = Перечисления.ТипыЦен.Розничная;
		Иначе Если Объект.ТипРеализации = Перечисления.ТипыРеализации.Опт Тогда
			ТипЦены = Перечисления.ТипыЦен.Оптовая;
		КонецЕсли;
	КонецЕсли;
			
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	               |ГДЕ
	               |     ЦеныНоменклатурыСрезПоследних.ТипЦены = &ТипЦены
	               |	И ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
	               |	И ЦеныНоменклатурыСрезПоследних.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("ТипЦены", ТипЦены);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
       Запрос.УстановитьПараметр("Характеристика", Характеристика); 
	   
	 Результат = Запрос.Выполнить();  
     Если Результат.Пустой() Тогда
        // Если ничего не найдено, возвращаем 0
        Возврат 0;
    Иначе
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        // 2. Если цена найдена, ВОЗВРАЩАЕМ ее клиенту
        Возврат Выборка.Цена;
	КонецЕсли;
КонецФункции


&НаКлиенте
Процедура ОбновитьЦенуВТекущейСтроке()
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		
	Если ЗначениеЗаполнено(Объект.ТипРеализации) И ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) И ЗначениеЗаполнено(ТекущаяСтрока.Характеристика) Тогда
		ПолученнаяЦена = ПолучитьЦенуНаСервере(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика);
		ТекущаяСтрока.Цена = ПолученнаяЦена;   
		ТоварыЦенаПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	ИтогПоСумме = Объект.Товары.Итог("Сумма");
	Объект.СуммаДокумента = ИтогПоСумме;
КонецПроцедуры    

&НаСервере
Функция ПроверитьНоменклатуруНаНаличиеХарактеристикНаСервере(ВыбраннаяНоменклатура)
    // Если номенклатура пустая, проверять нечего
    Если ВыбраннаяНоменклатура.Пустая() Тогда
        Возврат Истина;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ЕСТЬNULL(ХарактеристикиНоменклатуры.Ссылка, НЕОПРЕДЕЛЕНО) КАК Ссылка
        |ИЗ
        |   Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
        |ГДЕ
        |   ХарактеристикиНоменклатуры.Владелец = &Владелец";
        
    Запрос.УстановитьПараметр("Владелец", ВыбраннаяНоменклатура);
    
    // Если запрос не вернул ни одной строки, значит, характеристик нет
    Если НЕ Запрос.Выполнить().Пустой() Тогда
        Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;    	
КонецФункции

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ОбновитьЦенуВТекущейСтроке();
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
       ПроверкаПрошла = ПроверитьНоменклатуруНаНаличиеХарактеристикНаСервере(ТекущаяСтрока.Номенклатура);   
	   Если НЕ ПроверкаПрошла Тогда
		   	ТекстОшибки = "Для номенклатуры '" + ТекущаяСтрока.Номенклатура + "' не заведено ни одной характеристики! "
                  + "Использование в документах невозможно. Пожалуйста, откройте карточку товара и исправьте."; 
			ТекущаяСтрока.Номенклатура = Неопределено;
			ВызватьИсключение(ТекстОшибки); 
	КонецЕсли
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)
	ОбновитьЦенуВТекущейСтроке();
КонецПроцедуры       

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	РассчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	РассчитатьСуммуДокумента();
КонецПроцедуры 

&НаСервере
Функция НужноОтобразитьКонтрагента() 
	Возврат Объект.ТипРеализации = Перечисления.ТипыРеализации.Опт;		
КонецФункции

&НаКлиенте
Процедура ТипРеализацииПриИзменении(Элемент)
	Если НужноОтобразитьКонтрагента() Тогда
		Элементы.Контрагент.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НужноОтобразитьКонтрагента() и НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Сообщить("Для оптовых продаж нужно указать контрагента!");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.Контрагент.Видимость = НужноОтобразитьКонтрагента();
КонецПроцедуры

 








