Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
   
    Движения.ТоварыНаСкладах.Записывать = Истина;
    // Очищаем старые движения, если документ перепроводится
    Движения.ТоварыНаСкладах.Записать();   
	
    
    Для Каждого ТекСтрокаТовары Из Товары Цикл
        
        // --- 2. Получаем текущую себестоимость списываемой серии ---
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |   ТоварыНаСкладахОстатки.СуммаОстаток,
            |   ТоварыНаСкладахОстатки.КоличествоОстаток
            |ИЗ
            |   РегистрНакопления.ТоварыНаСкладах.Остатки(
            |       &МоментВремени,
            |       Склад = &Склад
            |           И Номенклатура = &Номенклатура
            |           И Характеристика = &Характеристика
            |           И Серия = &Серия) КАК ТоварыНаСкладахОстатки";
            
        Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
        Запрос.УстановитьПараметр("Склад", Склад); // Из шапки документа
        Запрос.УстановитьПараметр("Номенклатура", ТекСтрокаТовары.Номенклатура);
        Запрос.УстановитьПараметр("Характеристика", ТекСтрокаТовары.Характеристика);
        Запрос.УстановитьПараметр("Серия", ТекСтрокаТовары.Серия);
        
        Выборка = Запрос.Выполнить().Выбрать();
        
        СуммаСписания = 0;
        Если Выборка.Следующий() Тогда
            // Рассчитываем себестоимость одной штуки и умножаем на количество
            Если Выборка.КоличествоОстаток <> 0 Тогда
                СебестоимостьОднойШтуки = Выборка.СуммаОстаток / Выборка.КоличествоОстаток;
                СуммаСписания = СебестоимостьОднойШтуки * ТекСтрокаТовары.Количество;
			КонецЕсли;  
			Если Выборка.КоличествоОстаток < ТекСтрокаТовары.Количество Тогда
				Сообщить("Вы собираетесь списать больше товара, чем его есть на складе! Введенное количество: " + ТекСтрокаТовары.Количество + ", остаток на складе: " + Выборка.КоличествоОстаток);
				Отказ = Истина;
			КонецЕсли;
        КонецЕсли;
        
        Движение = Движения.ТоварыНаСкладах.ДобавитьРасход(); 
	Движение.Период = Дата;
        
        // Заполняем измерения
        Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
        Движение.Характеристика = ТекСтрокаТовары.Характеристика;
        Движение.Серия = ТекСтрокаТовары.Серия;
        Движение.Склад = Склад;
        
        // Заполняем ресурсы
        Движение.Количество = ТекСтрокаТовары.Количество;
        Движение.Сумма = СуммаСписания; // Подставляем рассчитанную себестоимость
        
    КонецЦикла;

КонецПроцедуры